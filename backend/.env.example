APP_NAME=SGU Campus Guide
ENVIRONMENT=development
# Optional. Leave empty when running the Vite development server.
FRONTEND_DIST=
# Paste the Atlas Drivers/Python URI here in your private backend/.env.
# Empty URI keeps liveness available; /api/v1/health/ready returns 503.
MONGODB_URI=
MONGODB_DATABASE=sgu_campus_guide
MONGODB_TIMEOUT_MS=3000
# At least 32 random bytes. Private; changing this invalidates JWT/CSRF tokens.
JWT_SECRET=
# Exact frontend origins as a JSON array. Vite proxies /api to the backend.
AUTH_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
# Location simulation is not implemented yet; default remains disabled.
DEMO_MODE=false
# Reserved for AI integration; select an accessible Gemini model explicitly.
GEMINI_API_KEY=
GEMINI_MODEL=
