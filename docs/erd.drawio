        <mxCell id="tbl_fs_files" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-family:sans-serif;font-size:11px;&quot;&gt;&#xa;&lt;tr style=&quot;background-color:#B45309;color:#FFFFFF;&quot;&gt;&lt;th colspan=&quot;2&quot; style=&quot;padding:6px;border-bottom:1px solid #92400E;&quot;&gt;&lt;b&gt;fs.files&lt;/b&gt; (30 docs | 2 indexes)&lt;/th&gt;&lt;/tr&gt;&#xa;&lt;tr style=&quot;background-color:#FEF3C7;&quot;&gt;&lt;td style=&quot;padding:4px;&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px;&quot;&gt;&lt;b&gt;_id&lt;/b&gt; : ObjectId&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr&gt;&lt;td style=&quot;padding:4px;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px;&quot;&gt;filename : string (&quot;poi_XX_lang.mp3&quot;)&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr style=&quot;background-color:#FFFBEB;&quot;&gt;&lt;td style=&quot;padding:4px;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px;&quot;&gt;length : int (Tổng dung lượng bytes)&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr&gt;&lt;td style=&quot;padding:4px;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px;&quot;&gt;chunkSize : int (261120 = 255 KiB)&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr style=&quot;background-color:#FFFBEB;&quot;&gt;&lt;td style=&quot;padding:4px;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px;&quot;&gt;uploadDate : datetime (UTC)&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr&gt;&lt;td style=&quot;padding:4px;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px;&quot;&gt;metadata : document&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;/table&gt;" style="html=1;overflow=fill;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.5;rounded=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="650" width="300" height="190" as="geometry" />
        </mxCell>

        <!-- 3. fs.chunks -->
        <mxCell id="tbl_fs_chunks" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-family:sans-serif;font-size:11px;&quot;&gt;&#xa;&lt;tr style=&quot;background-color:#B45309;color:#FFFFFF;&quot;&gt;&lt;th colspan=&quot;2&quot; style=&quot;padding:6px;border-bottom:1px solid #92400E;&quot;&gt;&lt;b&gt;fs.chunks&lt;/b&gt; (30 docs | 2 indexes | 5.46 MB)&lt;/th&gt;&lt;/tr&gt;&#xa;&lt;tr style=&quot;background-color:#FEF3C7;&quot;&gt;&lt;td style=&quot;padding:4px;&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px;&quot;&gt;&lt;b&gt;_id&lt;/b&gt; : ObjectId&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr&gt;&lt;td style=&quot;padding:4px;&quot;&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px;&quot;&gt;files_id : ObjectId (fs.files._id)&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr style=&quot;background-color:#FFFBEB;&quot;&gt;&lt;td style=&quot;padding:4px;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px;&quot;&gt;n : int (Khối nhị phân: 0, 1, 2...)&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;tr&gt;&lt;td style=&quot;padding:4px;&quot;&gt;&lt;b&gt;Bin&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px;&quot;&gt;data : binary (Chunk thô 255 KiB)&lt;/td&gt;&lt;/tr&gt;&#xa;&lt;/table&gt;" style="html=1;overflow=fill;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.5;rounded=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1145" y="650" width="340" height="150" as="geometry" />
        </mxCell>

        <!-- ========================================== -->
        <!-- MỐI QUAN HỆ & LIÊN KẾT (RELATIONSHIPS)    -->
        <!-- ========================================== -->

        <!-- users (1) -> (N) sessions -->
        <mxCell id="rel_users_sessions" value="1 : N" style="endArrow=ERmany;startArrow=ERone;html=1;strokeColor=#DB2777;strokeWidth=1.8;fontSize=11;fontStyle=1;" edge="1" source="tbl_users" target="tbl_sessions" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- users (1) -> (N) tours -->
        <mxCell id="rel_users_tours" value="sửa nháp" style="endArrow=ERmany;startArrow=ERone;html=1;strokeColor=#2563EB;strokeWidth=1.5;fontSize=10;dashed=1;" edge="1" source="tbl_users" target="tbl_tours" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- tours (1) -> (N) tour_releases -->
        <mxCell id="rel_tours_releases" value="1 : N (Tạo Snapshot)" style="endArrow=ERmany;startArrow=ERone;html=1;strokeColor=#2563EB;strokeWidth=2;fontSize=11;fontStyle=1;" edge="1" source="tbl_tours" target="tbl_releases" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- users (1) -> (N) tour_releases -->
        <mxCell id="rel_users_releases" value="công bố" style="endArrow=ERmany;startArrow=ERone;html=1;strokeColor=#1D4ED8;strokeWidth=1.5;fontSize=10;dashed=1;" edge="1" source="tbl_users" target="tbl_releases" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="195" y="70" />
              <mxPoint x="880" y="70" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- tour_releases (1) -> (N) usage_events -->
        <mxCell id="rel_releases_events" value="1 : N (Sự kiện khách)" style="endArrow=ERmany;startArrow=ERone;html=1;strokeColor=#059669;strokeWidth=2;fontSize=11;fontStyle=1;" edge="1" source="tbl_releases" target="tbl_usage_events" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- assets (1) -> (N) audio_selections -->
        <mxCell id="rel_assets_selections" value="1 : N (Ghim)" style="endArrow=ERmany;startArrow=ERone;html=1;strokeColor=#D97706;strokeWidth=1.8;fontSize=11;fontStyle=1;" edge="1" source="tbl_assets" target="tbl_audio_selections" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- assets (1) -> (1) fs.files -->
        <mxCell id="rel_assets_fs_files" value="1 : 1 (Tệp GridFS)" style="endArrow=ERone;startArrow=ERone;html=1;strokeColor=#B45309;strokeWidth=2;fontSize=11;fontStyle=1;" edge="1" source="tbl_assets" target="tbl_fs_files" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- fs.files (1) -> (N) fs.chunks -->
        <mxCell id="rel_files_chunks" value="1 : N (Khối 255 KiB)" style="endArrow=ERmany;startArrow=ERone;html=1;strokeColor=#B45309;strokeWidth=2.2;fontSize=11;fontStyle=1;" edge="1" source="tbl_fs_files" target="tbl_fs_chunks" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Ghi chú đối chiếu MongoDB Compass -->
        <mxCell id="note_compass" value="&lt;b&gt;ĐỐI CHIẾU CHUẨN XÁC 100% VỚI MONGODB COMPASS:&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;b&gt;Đúng 10 Collections:&lt;/b&gt; assets, audio_selections, fs.chunks, fs.files, sessions, tour_releases, tours, usage_events, users, visitor_presence.&lt;br&gt;&amp;bull; &lt;b&gt;10 POIs &amp;amp; Bản dịch đa ngữ:&lt;/b&gt; Được nhúng trực tiếp (Embedded) vào &lt;i&gt;tours.draft.places&lt;/i&gt; và &lt;i&gt;tour_releases.draft.places&lt;/i&gt;, tối ưu 1 query lấy trọn vẹn dữ liệu tour.&lt;br&gt;&amp;bull; &lt;b&gt;GridFS Streaming:&lt;/b&gt; 30 file MP3 lưu metadata ở &lt;i&gt;fs.files&lt;/i&gt; và chia khối nhị phân 5.46 MB trong &lt;i&gt;fs.chunks&lt;/i&gt; phục vụ HTTP 206 Partial Content.&lt;br&gt;&amp;bull; &lt;b&gt;TTL Index tự động:&lt;/b&gt; &lt;i&gt;visitor_presence&lt;/i&gt; xóa sau 180s, &lt;i&gt;sessions&lt;/i&gt; xóa sau 7 ngày." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#1E293B;fillColor=#FFF8E1;strokeColor=#F59E0B;fontSize=11;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="280" height="85" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
