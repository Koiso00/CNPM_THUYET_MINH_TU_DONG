  <!-- TAB 3: CHI TIẾT PHÂN HỆ QUẢN TRỊ VIÊN (ADMIN) -->
  <!-- ==================================================== -->
  <diagram id="tab3-admin" name="3. Chi tiết - Quản trị viên">
    <mxGraphModel dx="1422" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="a_boundary" value="Phân hệ Quản trị viên (Admin Subsystem)" style="shape=rect;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;dashed=1;dashPattern=6 3;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="50" width="900" height="740" as="geometry" />
        </mxCell>

        <mxCell id="a_actor" value="Quản trị viên&#xa;(Admin: phong)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="350" width="70" height="120" as="geometry" />
        </mxCell>

        <mxCell id="a_uc05" value="UC05: Đăng nhập hệ thống&#xa;• Xác thực mật khẩu Argon2id&#xa;• Cấp phát 3 HttpOnly Cookies (JWT, Refresh, CSRF)&#xa;• Cơ chế Silent Token Refresh tự động gia hạn" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DB2777;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="80" width="310" height="100" as="geometry" />
        </mxCell>

        <mxCell id="a_uc06" value="UC06: Biên tập nội dung &amp; audio 10 địa điểm&#xa;• Upload MP3 vào GridFS (tối đa 10MB)&#xa;• Sửa tiêu đề, bài dịch EN/KO của 10 POI cố định&#xa;• Cơ chế CAS Optimistic Locking chống xung đột ghi đè" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DB2777;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="210" width="330" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a_uc07" value="UC07: Quản lý công bố bản thuyết minh&#xa;• Pre-publish Checklist kiểm tra đủ tọa độ &amp; audio&#xa;• Đóng gói Snapshot bất biến vào tour_releases&#xa;• Chuyển con trỏ published_release_id hoặc gỡ bỏ" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DB2777;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="390" width="310" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a_uc08" value="UC08: Xem thống kê báo cáo (Dashboard)&#xa;• Thống kê người đang online theo thời gian thực (TTL)&#xa;• Thống kê lượt khách, hành trình, lượt nghe theo ngày ICT&#xa;• Biểu đồ phân bổ lượt nghe cho từng điểm (loại trừ mô phỏng)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DB2777;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="560" width="330" height="110" as="geometry" />
        </mxCell>

        <mxCell id="edge_a1" style="endArrow=none;html=1;strokeColor=#DB2777;strokeWidth=2;entryX=1;entryY=0.5;" edge="1" parent="1" source="a_actor" target="a_uc05" />
        <mxCell id="edge_a2" style="endArrow=none;html=1;strokeColor=#DB2777;strokeWidth=2;entryX=1;entryY=0.5;" edge="1" parent="1" source="a_actor" target="a_uc06" />
        <mxCell id="edge_a3" style="endArrow=none;html=1;strokeColor=#DB2777;strokeWidth=2;entryX=1;entryY=0.5;" edge="1" parent="1" source="a_actor" target="a_uc07" />
        <mxCell id="edge_a4" style="endArrow=none;html=1;strokeColor=#DB2777;strokeWidth=2;entryX=1;entryY=0.5;" edge="1" parent="1" source="a_actor" target="a_uc08" />

        <!-- Includes -->
        <mxCell id="rel_inc_06" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;strokeColor=#DB2777;strokeWidth=1.5;entryX=1;entryY=0.5;exitX=0;exitY=0.5;" edge="1" parent="1" source="a_uc06" target="a_uc05">
