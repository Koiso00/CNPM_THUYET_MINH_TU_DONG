  <!-- TAB 2: CHI TIẾT PHÂN HỆ KHÁCH THAM QUAN (VISITOR) -->
  <!-- ==================================================== -->
  <diagram id="tab2-visitor" name="2. Chi tiết - Khách tham quan">
    <mxGraphModel dx="1422" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="v_boundary" value="Phân hệ Khách tham quan (Visitor Features)" style="shape=rect;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;dashed=1;dashPattern=6 3;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="50" width="880" height="720" as="geometry" />
        </mxCell>

        <mxCell id="v_actor" value="Khách tham quan&#xa;(Visitor)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="320" width="70" height="120" as="geometry" />
        </mxCell>

        <mxCell id="v_uc01" value="UC01: Khám phá khuôn viên qua bản đồ&#xa;• Tải Stadia Maps vector tile&#xa;• Hiển thị 10 Marker POI theo tọa độ GeoJSON&#xa;• Bấm Marker mở Drawer xem ảnh &amp; thông tin" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="90" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="v_uc02" value="UC02: Nghe thuyết minh audio địa điểm&#xa;• Stream MP3 qua HTTP 206 Partial Content&#xa;• Tua thời gian (Seek Bar Range Byte)&#xa;• Điều khiển Play/Pause/Stop mượt mà" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="190" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="v_uc03" value="UC03: Định vị GPS &amp; Mô phỏng vị trí&#xa;• Bật GPS thực tế (navigator.geolocation)&#xa;• Chế độ mô phỏng (Simulation switch)&#xa;• Thuật toán Haversine &amp; Geofence Hysteresis" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="340" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="v_uc04" value="UC04: Lựa chọn ngôn ngữ&#xa;• Hỗ trợ 3 ngôn ngữ: Tiếng Việt, English, 한국어&#xa;• Lưu mã ngôn ngữ LocalStorage (sgu_language)&#xa;• Đồng bộ nội dung giao diện &amp; file audio" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="580" width="280" height="100" as="geometry" />
        </mxCell>

        <!-- Sub use cases / extensions -->
        <mxCell id="v_sub_presence" value="Gửi tín hiệu Heartbeat&#xa;(POST /events/presence - định kỳ 30s)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="440" width="250" height="70" as="geometry" />
        </mxCell>

        <mxCell id="edge_v1" style="endArrow=none;html=1;strokeColor=#2563EB;strokeWidth=2;entryX=0;entryY=0.5;" edge="1" parent="1" source="v_actor" target="v_uc01" />
        <mxCell id="edge_v2" style="endArrow=none;html=1;strokeColor=#2563EB;strokeWidth=2;entryX=0;entryY=0.5;" edge="1" parent="1" source="v_actor" target="v_uc02" />
        <mxCell id="edge_v3" style="endArrow=none;html=1;strokeColor=#2563EB;strokeWidth=2;entryX=0;entryY=0.5;" edge="1" parent="1" source="v_actor" target="v_uc03" />
        <mxCell id="edge_v4" style="endArrow=none;html=1;strokeColor=#2563EB;strokeWidth=2;entryX=0;entryY=0.5;" edge="1" parent="1" source="v_actor" target="v_uc04" />

        <mxCell id="rel_v_geo" value="&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;&#xa;(Khoảng cách &amp;lt;= 30m kích hoạt phát)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;strokeColor=#2563EB;strokeWidth=1.5;entryX=0.5;entryY=1;exitX=1;exitY=0.5;" edge="1" parent="1" source="v_uc03" target="v_uc02">
          <mxGeometry width="160" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="940" y="390" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="rel_v_pres" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;&#xa;(Tự động gửi khi đang mở trang)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;strokeColor=#64748B;strokeWidth=1.5;entryX=0.5;entryY=0;exitX=0.75;exitY=1;" edge="1" parent="1" source="v_uc01" target="v_sub_presence">
          <mxGeometry width="160" relative="1" as="geometry">
